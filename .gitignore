# Python-generated files
__pycache__/
*.py[oc]
.coverage
.pytest_cache/
.ruff_cache/
htmlcov/
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Android build state and signing keys stay local
.gradle/
local.properties
*.jks
*.keystore
.signing/
*.apk

# macOS
.DS_Store
**/.DS_Store

# PyInstaller artefacts
build/
dist/
*.spec.bak

# Source files and generated exports may contain resident data — keep them local
data/*
!data/.gitkeep
exports/*
!exports/.gitkeep
