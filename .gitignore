# Python-generated files
__pycache__/
*.py[oc]
.coverage
.pytest_cache/
.ruff_cache/
htmlcov/
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-ml

# Android build state and signing keys stay local
.gradle/
local.properties
*.jks
*.keystore
.signing/
*.apk

# Trained models and decrypted dataset exports are generated locally.
models/releases/*
!models/releases/.gitkeep
android/app/src/main/assets/package_audit_label.onnx
android/app/src/main/assets/package_audit_model_manifest.json
android/app/src/main/assets/package_audit_model_manifest.sig
android/app/src/main/assets/package_audit_model_public.pem

# macOS
.DS_Store
**/.DS_Store

# PyInstaller artefacts
*.spec.bak

# Source files and generated exports may contain resident data — keep them local
data/*
!data/.gitkeep
exports/*
!exports/.gitkeep
